# ---------- Server ----------
NODE_ENV=development
PORT=4020
HOST=0.0.0.0
LOG_LEVEL=info
# Set when running behind nginx/Caddy/a load balancer (e.g. 1) so client IPs and rate limits are correct.
TRUST_PROXY=
# Extra browser origins allowed to call the API with cookies (comma separated). Same-origin needs nothing.
CORS_ORIGINS=
TIMEZONE=Asia/Kolkata

# ---------- Database ----------
DB_CLIENT=sqlite
SQLITE_FILE=./db/vasamo.sqlite3
# DB_CLIENT=pg
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/vasamo
# DB_SSL=false
# DB_POOL_MAX=10

# ---------- Restaurant (printed on bills) ----------
RESTAURANT_NAME=Vasamo
RESTAURANT_TAGLINE=South Indian Kitchen
RESTAURANT_ADDRESS=Chennai, Tamil Nadu
RESTAURANT_PHONE=
GSTIN=
FSSAI_LICENSE=

# ---------- Billing ----------
BILL_PREFIX=VAS
# Restaurants: 5% GST (2.5% CGST + 2.5% SGST), no input tax credit.
GST_RATE=5
# Service charge must be optional for the guest (CCPA guidelines, July 2022). Keep 0 unless you show it as optional.
DEFAULT_SERVICE_RATE=0
# true: a sale still goes through when book stock says an ingredient is short (stock goes negative and is flagged).
# false: the bill is refused until stock is received or counted.
ALLOW_NEGATIVE_STOCK=true
EXPIRING_DAYS=2

# ---------- Sessions ----------
SESSION_HOURS=12
# Defaults to true when NODE_ENV=production. Set false only for plain-HTTP LAN installs.
COOKIE_SECURE=

# ---------- Seeding ----------
# Password for the seeded admin / manager / cashier accounts (required when NODE_ENV=production).
SEED_PASSWORD=
# Days of demo trading to generate (0 = clean install with opening stock only).
SEED_DEMO_DAYS=14

# ---------- Email receipts (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=Vasamo <onboarding@resend.dev>
EMAIL_REPLY_TO=

# ---------- AI Captain / Kitchen Terminal integration ----------
# Shared secret sent as the X-Api-Key header (at least 24 characters). Empty = integration off.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ORDER_API_KEY=
ORDER_SERVICE_RATE=0
