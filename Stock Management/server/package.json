{
  "name": "vasamo-stock-server",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../shared --watch-path=.env --watch-path=knexfile.js src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
