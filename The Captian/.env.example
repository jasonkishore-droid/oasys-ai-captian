GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Achird
# Inventory (menu, orders, e-receipts) runs inside this app, on the Stock Management database.
# Bill settings and RESEND_API_KEY are read from Stock Management/server/.env; set them here to override.
# INVENTORY_DIR=../Stock Management/server
# INVENTORY_DB=../Stock Management/server/db/vasamo.sqlite3
# Printing still goes through the Stock Management app (its tab drives the Bluetooth printer):
INVENTORY_API_URL=http://127.0.0.1:4020
ORDER_API_KEY=
